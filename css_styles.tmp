@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

:root{
  --navy-950:#071522;
  --navy-900:#0b1f33;
  --navy-800:#12304a;
  --navy-700:#1b4667;
  --gold:#e4b65f;
  --gold-dark:#c9953e;
  --ink:#152638;
  --muted:#687684;
  --paper:#ffffff;
  --soft:#f4f6f7;
  --line:#dfe5e9;
  --line-dark:rgba(255,255,255,.16);
  --container:1180px;
  --shadow:0 18px 45px rgba(7,21,34,.12);
  --radius:12px;
  --font-body:'DM Sans',Arial,sans-serif;
  --font-display:'Playfair Display',Georgia,serif;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:var(--font-body);color:var(--ink);background:var(--paper);line-height:1.7}
body{overflow-x:hidden}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
button,input,textarea,select{font:inherit}
.container{width:min(var(--container),calc(100% - 48px));margin-inline:auto}

/* Header */
.site-header{position:absolute;top:0;left:0;width:100%;z-index:100;background:linear-gradient(to bottom,rgba(5,17,28,.72),rgba(5,17,28,0));border:0}
.site-header .container{height:88px;display:flex;align-items:center;justify-content:space-between;gap:30px}
.brand{display:flex;align-items:center;gap:12px;color:#fff;min-width:230px}
.brand-logo{width:52px;height:52px;flex:0 0 52px}
.brand-copy{display:flex;flex-direction:column;line-height:1}
.brand-name{font-family:var(--font-display);font-size:1.55rem;letter-spacing:.08em;text-transform:uppercase;font-weight:600}
.brand-sub{font-size:.57rem;letter-spacing:.29em;text-transform:uppercase;color:#d8e0e7;margin-top:7px}
.main-nav>ul{list-style:none;display:flex;align-items:center;gap:28px;margin:0;padding:0}
.main-nav li{position:relative}
.main-nav a{color:rgba(255,255,255,.94);font-size:.86rem;font-weight:500;white-space:nowrap;transition:color .2s ease}
.main-nav a:hover{color:var(--gold)}
.products-link{display:inline-flex;align-items:center;gap:7px;cursor:pointer}
.products-link::after{content:'';width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translateY(-2px);transition:transform .2s ease}
.products-dropdown{position:absolute;top:calc(100% + 18px);right:-18px;width:245px;padding:9px;background:rgba(7,21,34,.98);border:1px solid rgba(255,255,255,.1);border-radius:10px;box-shadow:0 20px 45px rgba(0,0,0,.28);opacity:0;visibility:hidden;transform:translateY(-8px);transition:opacity .18s ease,transform .18s ease,visibility .18s ease}
.products-dropdown a{display:block;padding:12px 14px;border-radius:7px;color:#e9eef2;font-size:.82rem}
.products-dropdown a:hover{background:rgba(228,182,95,.12);color:var(--gold)}
.has-dropdown:hover .products-dropdown,.has-dropdown:focus-within .products-dropdown{opacity:1;visibility:visible;transform:translateY(0)}
.has-dropdown:hover .products-link::after{transform:rotate(225deg) translate(-1px,-1px)}
.nav-contact{background:linear-gradient(135deg,#f1c873,#d8a94f);color:#101b25!important;padding:11px 23px;border-radius:999px;font-weight:700!important;box-shadow:0 8px 22px rgba(0,0,0,.16)}
.nav-contact:hover{color:#101b25!important;transform:translateY(-1px)}
.nav-toggle{display:none;background:rgba(7,21,34,.45);border:1px solid rgba(255,255,255,.3);width:44px;height:44px;border-radius:8px;align-items:center;justify-content:center;cursor:pointer}
.nav-toggle span,.nav-toggle span::before,.nav-toggle span::after{content:'';display:block;width:20px;height:2px;background:#fff;position:relative;transition:.2s ease}
.nav-toggle span::before{position:absolute;top:-6px}.nav-toggle span::after{position:absolute;top:6px}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 23px;border-radius:7px;font-size:.88rem;font-weight:700;border:1px solid transparent;transition:transform .2s ease,background .2s ease,border-color .2s ease,box-shadow .2s ease}
.btn::after{content:'→';font-size:1rem;line-height:1}
.btn-primary{background:var(--gold);color:#12202c;box-shadow:0 9px 24px rgba(0,0,0,.14)}
.btn-primary:hover{background:#f0c873;transform:translateY(-2px)}
.btn-outline-light{border-color:rgba(255,255,255,.7);color:#fff;background:rgba(255,255,255,.04)}
.btn-outline-light:hover{background:rgba(255,255,255,.12);transform:translateY(-2px)}
.btn-outline-dark{border-color:#9ba9b4;color:var(--navy-900)}
.btn-outline-dark:hover{border-color:var(--navy-900);background:var(--navy-900);color:#fff}

/* Global hero treatment: image is always a background */
.hero{position:relative;min-height:650px;background:var(--navy-950);color:#fff;overflow:hidden}
.hero-grid{position:relative;min-height:650px;display:block}
.hero-media{position:absolute;inset:0;z-index:0;overflow:hidden}
.hero-media::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,18,30,.84) 0%,rgba(5,18,30,.66) 44%,rgba(5,18,30,.38) 100%),linear-gradient(0deg,rgba(5,18,30,.48),transparent 55%)}
.hero-media img{width:100%;height:100%;object-fit:cover;object-position:center}
.frame-marks{display:none}
.hero-copy{position:relative;z-index:2;width:min(720px,calc(100% - 48px));min-height:650px;display:flex;flex-direction:column;justify-content:center;padding:125px 0 105px;margin-inline:auto;margin-left:max(24px,calc((100vw - var(--container))/2));}
.hero-eyebrow,.kicker,.cap{display:inline-block;text-transform:uppercase;letter-spacing:.18em;font-size:.72rem;font-weight:700;color:var(--gold)}
.hero-eyebrow{margin-bottom:18px}
.hero h1{font-family:var(--font-display);font-weight:600;font-size:clamp(3.2rem,6vw,5.4rem);line-height:1.02;letter-spacing:-.035em;margin:0 0 22px;max-width:800px;color:#fff}
.lede{font-size:1.04rem;line-height:1.8;color:rgba(255,255,255,.88);max-width:680px;margin:0}
.hero-actions{display:flex;flex-wrap:wrap;gap:13px;margin-top:30px}
.stat-strip{position:absolute;z-index:3;left:50%;bottom:0;transform:translateX(-50%);width:min(var(--container),calc(100% - 48px));display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.24);background:rgba(7,21,34,.18);backdrop-filter:blur(4px)}
.stat-strip>div{padding:20px 22px;text-align:center;border-right:1px solid rgba(255,255,255,.16)}
.stat-strip>div:last-child{border-right:0}
.stat-num{display:block;font-family:var(--font-display);font-size:1.55rem;color:#fff;line-height:1.2}
.stat-label{display:block;margin-top:4px;font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.68)}

/* Sections */
.section{padding:92px 0}
.section-alt{background:var(--soft)}
.section-dark{background:var(--navy-900);color:#fff}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:50px;margin-bottom:42px}
.section-head>div{max-width:680px}
.section-head>p{max-width:500px;margin:0;color:var(--muted)}
.kicker{margin-bottom:11px;color:var(--gold-dark)}
.section-dark .kicker{color:var(--gold)}
h2,h3,h4{margin-top:0}
h2{font-family:var(--font-display);font-size:clamp(2.1rem,4vw,3.35rem);line-height:1.12;letter-spacing:-.025em;margin-bottom:0;color:var(--navy-900)}
.section-dark h2{color:#fff}
h3{font-family:var(--font-display);font-size:1.65rem;line-height:1.25;color:var(--navy-900)}
p{margin-top:0;color:var(--muted)}
.section-dark p{color:rgba(255,255,255,.74)}

/* Value band */
.value-band{background:#fff;border-bottom:1px solid var(--line)}
.value-grid{display:grid;grid-template-columns:repeat(4,1fr)}
.value-item{padding:31px 25px;text-align:center;border-right:1px solid var(--line)}
.value-item:last-child{border-right:0}
.value-icon{width:45px;height:45px;margin:0 auto 15px;border:1px solid #b7c3cc;border-radius:50%;display:grid;place-items:center;color:var(--navy-800);font-size:1.1rem}
.value-item h4{font-size:.96rem;margin:0 0 6px;color:var(--navy-900)}
.value-item p{font-size:.83rem;line-height:1.55;margin:0}

/* Home about */
.about-home{position:relative;overflow:hidden;background:#f7f8f8}
.about-home::after{content:'';position:absolute;right:-4%;bottom:-18%;width:52%;height:95%;background:url('../images/06_Heavy_Equipment_Manufacturing_Facility.jpg') center/cover no-repeat;opacity:.08;filter:grayscale(1);pointer-events:none}
.about-layout{position:relative;z-index:1;display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center}
.about-copy p{max-width:630px}
.about-copy .btn{margin-top:13px}
.stats-card{background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);display:grid;grid-template-columns:repeat(3,1fr);overflow:hidden}
.stats-card div{padding:31px 20px;text-align:center;border-right:1px solid var(--line)}
.stats-card div:last-child{border-right:0}
.stats-card strong{display:block;font-family:var(--font-display);font-size:2.25rem;color:var(--navy-800);line-height:1.1}
.stats-card span{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-top:8px}

/* Product cards */
.card-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.division-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:0 7px 25px rgba(7,21,34,.06);transition:transform .25s ease,box-shadow .25s ease}
.division-card:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
.thumb{aspect-ratio:4/3;overflow:hidden;background:#dfe5e8}
.thumb img{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}
.division-card:hover .thumb img{transform:scale(1.045)}
.division-card .body{padding:24px 23px 27px}
.division-card h3{font-size:1.35rem;margin-bottom:10px}
.division-card p{font-size:.88rem;line-height:1.65;margin-bottom:17px}
.card-link{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700;color:var(--navy-800)}
.card-link::after{content:' →';color:var(--gold-dark)}

/* Feature rows */
.feature-row{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:65px;margin-top:65px}
.feature-row:first-child{margin-top:0}
.feature-row.reverse .row-media{order:2}
.row-media{border-radius:12px;overflow:hidden;box-shadow:var(--shadow);background:#e8ecef}
.row-media img{width:100%;aspect-ratio:16/10;object-fit:cover}
.row-copy h3{font-size:2rem;margin:8px 0 16px}
.row-copy p{max-width:560px}
.spec-list{padding:0;margin:18px 0 0;list-style:none}
.spec-list li{position:relative;padding:9px 0 9px 24px;border-bottom:1px solid var(--line);color:var(--ink);font-size:.92rem}
.spec-list li::before{content:'✓';position:absolute;left:0;color:var(--gold-dark);font-weight:700}

/* Page headers */
.page-header{position:relative;min-height:510px;display:flex;align-items:flex-end;padding:145px 0 72px;color:#fff;background:var(--navy-900);overflow:hidden}
.page-header::before{content:'';position:absolute;inset:0;background-image:var(--page-bg);background-position:center;background-size:cover;opacity:.62}
.page-header::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,18,30,.86),rgba(5,18,30,.48)),linear-gradient(0deg,rgba(5,18,30,.7),transparent 65%)}
.page-header .container{position:relative;z-index:1}
.page-header h1{font-family:var(--font-display);font-size:clamp(2.7rem,5vw,4.6rem);line-height:1.05;color:#fff;max-width:850px;margin:0 0 17px}
.page-header .lede{max-width:750px}
body.page-about .page-header{--page-bg:url('../images/06_Heavy_Equipment_Manufacturing_Facility.jpg')}
body.page-contact .page-header{--page-bg:url('../images/09_Heavy_Fabrication_Welding.jpg')}
body.page-hydraulic .hero-media img{object-position:center}
body.page-hydraulic .hero{--hero-bg:url('../images/01_Hydraulic_Cylinders_Product_Range.jpg')}

/* CTA */
.cta-banner{position:relative;overflow:hidden;background:var(--navy-900);color:#fff;padding:66px 0}
.cta-banner::before{content:'';position:absolute;inset:0;background:url('../images/06_Heavy_Equipment_Manufacturing_Facility.jpg') center/cover no-repeat;opacity:.18}
.cta-banner .container{position:relative;display:flex;justify-content:space-between;align-items:center;gap:30px}
.cta-banner h2{color:#fff;font-size:2.1rem;margin-bottom:8px}
.cta-banner p{color:rgba(255,255,255,.7);margin:0}

/* Contact */
.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:25px}
.contact-info,.contact-form{background:#fff;border:1px solid var(--line);border-radius:12px;padding:36px;box-shadow:0 8px 30px rgba(7,21,34,.06)}
.contact-info h2,.contact-form h2{font-size:2rem;margin-bottom:25px}
.contact-info dl{margin:0}
.contact-info dt{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:var(--gold-dark);margin-top:18px}
.contact-info dd{margin:3px 0 0;color:var(--ink)}
.form-note{font-size:.82rem;margin-top:28px;padding-top:20px;border-top:1px solid var(--line)}
.contact-form form{display:grid;gap:15px}
.contact-form label{font-size:.78rem;font-weight:700;color:var(--ink)}
.contact-form input,.contact-form textarea,.contact-form select{width:100%;margin-top:6px;border:1px solid #cbd4da;border-radius:7px;padding:12px 13px;background:#fff;color:var(--ink);outline:none;transition:border-color .2s,box-shadow .2s}
.contact-form textarea{min-height:150px;resize:vertical}
.contact-form input:focus,.contact-form textarea:focus,.contact-form select:focus{border-color:var(--gold-dark);box-shadow:0 0 0 3px rgba(228,182,95,.16)}

/* Footer */
.site-footer{background:var(--navy-950);color:#fff;padding:55px 0 0}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.15fr;gap:42px;padding-bottom:45px}
.footer-brand .brand{min-width:0;margin-bottom:16px}
.footer-brand p{max-width:390px;color:rgba(255,255,255,.6);font-size:.82rem}
.footer-col h5{font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin:7px 0 15px}
.footer-col ul{list-style:none;margin:0;padding:0}
.footer-col li{margin:8px 0;color:rgba(255,255,255,.65);font-size:.82rem}
.footer-col a:hover{color:#fff}
.footer-bottom{display:flex;justify-content:space-between;gap:20px;border-top:1px solid rgba(255,255,255,.12);padding:19px 0;font-size:.7rem;color:rgba(255,255,255,.45)}

/* Reveal */
.reveal{opacity:0;transform:translateY(18px);transition:opacity .65s ease,transform .65s ease}
.reveal.is-visible{opacity:1;transform:none}

/* Mobile */
@media(max-width:980px){
  .main-nav{display:none;position:absolute;left:0;right:0;top:88px;background:rgba(7,21,34,.98);padding:12px 24px 20px;border-top:1px solid rgba(255,255,255,.12)}
  .main-nav.is-open{display:block}
  .main-nav>ul{flex-direction:column;align-items:stretch;gap:0}
  .main-nav li{border-bottom:1px solid rgba(255,255,255,.08)}
  .main-nav a{display:block;padding:14px 4px}
  .nav-contact{display:inline-flex!important;margin-top:10px;padding:11px 21px!important;width:max-content}
  .products-dropdown{position:static;width:auto;margin:0 0 10px;padding:4px 0 4px 15px;background:rgba(255,255,255,.03);border:0;box-shadow:none;opacity:1;visibility:visible;transform:none;display:none}
  .has-dropdown.open .products-dropdown{display:block}
  .has-dropdown.open .products-link::after{transform:rotate(225deg) translate(-1px,-1px)}
  .nav-toggle{display:flex}
  .hero-copy{margin-left:24px}
  .card-grid{grid-template-columns:repeat(2,1fr)}
  .about-layout{grid-template-columns:1fr}
  .value-grid{grid-template-columns:repeat(2,1fr)}
  .value-item:nth-child(2){border-right:0}
  .value-item:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .footer-grid{grid-template-columns:1.3fr 1fr 1fr}
  .footer-grid .footer-col:last-child{grid-column:2 / -1}
}

@media(max-width:680px){
  .container{width:min(100% - 32px,var(--container))}
  .site-header .container{height:78px}
  .brand-logo{width:44px;height:44px;flex-basis:44px}
  .brand-name{font-size:1.25rem}
  .brand-sub{font-size:.48rem;letter-spacing:.2em}
  .main-nav{top:78px;padding-inline:16px}
  .hero,.hero-grid{min-height:680px}
  .hero-copy{width:calc(100% - 32px);margin-left:16px;min-height:680px;padding:125px 0 130px}
  .hero h1{font-size:clamp(2.65rem,14vw,4rem)}
  .hero-eyebrow{font-size:.65rem}
  .lede{font-size:.93rem;line-height:1.7}
  .hero-actions{margin-top:24px}
  .btn{padding:12px 17px;font-size:.82rem}
  .stat-strip{width:calc(100% - 32px);grid-template-columns:repeat(2,1fr)}
  .stat-strip>div{padding:13px 8px}
  .stat-num{font-size:1.25rem}
  .stat-label{font-size:.58rem}
  .section{padding:68px 0}
  .section-head{display:block;margin-bottom:30px}
  .section-head>p{margin-top:15px}
  h2{font-size:2.15rem}
  .value-grid,.card-grid,.feature-row,.contact-grid{grid-template-columns:1fr}
  .value-item,.value-item:nth-child(2){border-right:0;border-bottom:1px solid var(--line)}
  .value-item:last-child{border-bottom:0}
  .feature-row{gap:32px;margin-top:45px}
  .feature-row.reverse .row-media{order:0}
  .row-copy h3{font-size:1.65rem}
  .stats-card{grid-template-columns:1fr}
  .stats-card div{border-right:0;border-bottom:1px solid var(--line)}
  .stats-card div:last-child{border-bottom:0}
  .page-header{min-height:470px;padding:125px 0 58px}
  .page-header h1{font-size:2.8rem}
  .cta-banner .container{display:block}
  .cta-banner .btn{margin-top:22px}
  .footer-grid{grid-template-columns:1fr 1fr;gap:30px}
  .footer-grid .footer-col:last-child{grid-column:auto}
  .footer-bottom{display:block}
  .footer-bottom span{display:block;margin:5px 0}
}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}.division-card,.thumb img,.btn{transition:none}}
